PORT=8080
ENVIRONMENT=development
STORAGE_PATH=./storage
MAX_FILE_SIZE=524288000

# Runtime connection values for local (non-container) execution only.
# Docker Compose sets DATABASE_URL and REDIS_URL dynamically from mounted secrets.
DATABASE_URL=postgresql://securestor:change_me@localhost:5432/securestor?sslmode=disable
REDIS_URL=redis://:change_me@localhost:6379/0

# Optional fallback only when JWT_SECRET_FILE is not used
JWT_SECRET=change_me_for_local_dev_only

# Keycloak credentials (required by docker-compose.yml)
KEYCLOAK_ADMIN_PASSWORD=change_me_strong_admin_password
KEYCLOAK_DB_PASSWORD=change_me_strong_db_password

# Erasure Coding Configuration
ERASURE_DATA_SHARDS=4
ERASURE_PARITY_SHARDS=2

# Security scanning
ENABLE_SECURITY_SCANNING=true
SCANNER_TIMEOUT=600

# OPA
OPA_URL=http://opa:8181
OPA_ENABLED=true

# Encryption
ENCRYPTION_ENABLED=true
ENCRYPTION_ENFORCED=false
ENCRYPTION_MODE=mock
KEY_CACHE_TTL_MINUTES=5
KEY_ROTATION_DAYS=90
AWS_KMS_KEY_ID=alias/securestor-master-key
AWS_REGION=us-east-1